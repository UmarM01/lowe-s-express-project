<%- include('../partials/head', { title }) %>
<%- include('../partials/header', { activePage }) %>

<div class="container">
  <!-- Clean Hero -->
  <section class="hero">
    <h1>Courses for software engineers and systems builders</h1>
    <p>
      Small cohorts, practical labs, and direct feedback from senior engineers. We focus on modern web systems, machine learning, cloud architecture, and security.
    </p>

    <div class="hero-actions">
      <a href="/courses" class="btn btn-primary">Browse all courses</a>
      <a href="/about" class="btn btn-secondary">About the institute</a>
    </div>
  </section>

  <!-- Featured Courses -->
  <section class="section">
    <div class="section-header">
      <div>
        <h2 class="section-title">Featured Courses</h2>
        <div class="section-desc">Our core technical programs currently open for enrollment.</div>
      </div>
      <div>
        <a href="/courses" class="course-link">All <%= totalCourses %> courses &rarr;</a>
      </div>
    </div>

    <div class="courses-grid">
      <% if (featuredCourses && featuredCourses.length > 0) { %>
        <% featuredCourses.forEach(course => { %>
          <%- include('../partials/course-card', { course }) %>
        <% }); %>
      <% } %>
    </div>
  </section>
</div>

<%- include('../partials/footer') %>
