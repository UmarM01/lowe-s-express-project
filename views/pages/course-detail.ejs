<%- include('../partials/head', { title }) %>
<%- include('../partials/header', { activePage }) %>

<div class="container" style="padding-top: 2.5rem; padding-bottom: 5rem;">
  <a href="/courses" class="back-link">&larr; Back to all courses</a>

  <!-- Header -->
  <div class="detail-header">
    <div class="course-tag">
      <%= course.category %> &middot; <%= course.level %> Level
    </div>
    <h1><%= course.title %></h1>
    <p class="detail-lead"><%= course.summary %></p>
  </div>

  <div class="detail-grid">
    <!-- Main Description -->
    <div>
      <section class="detail-section">
        <h2>About this course</h2>
        <p><%= course.description %></p>
      </section>

      <% if (course.skillsLearned && course.skillsLearned.length > 0) { %>
        <section class="detail-section">
          <h2>Topics covered</h2>
          <ul class="simple-list">
            <% course.skillsLearned.forEach(skill => { %>
              <li><%= skill %></li>
            <% }); %>
          </ul>
        </section>
      <% } %>

      <section class="detail-section">
        <h2>Curriculum overview</h2>
        <ol class="syllabus-simple">
          <% course.syllabus.forEach(item => { %>
            <li>
              <strong><%= item.module %>:</strong> <%= item.title %>
            </li>
          <% }); %>
        </ol>
      </section>

      <section class="detail-section">
        <h2>Prerequisites</h2>
        <ul class="simple-list">
          <% course.prerequisites.forEach(prereq => { %>
            <li><%= prereq %></li>
          <% }); %>
        </ul>
      </section>
    </div>

    <!-- Sidebar Box -->
    <aside>
      <div class="course-sidebar-box">
        <div class="sidebar-price">
          $<%= course.price %>
        </div>

        <div style="margin-bottom: 1.5rem;">
          <div class="sidebar-row">
            <span>Duration</span>
            <strong><%= course.duration %></strong>
          </div>
          <div class="sidebar-row">
            <span>Format</span>
            <strong><%= course.format.split(' ')[0] %></strong>
          </div>
          <div class="sidebar-row">
            <span>Next Cohort</span>
            <strong><%= course.nextBatch %></strong>
          </div>
          <div class="sidebar-row">
            <span>Instructor</span>
            <strong><%= course.instructor.name %></strong>
          </div>
        </div>

        <button class="btn btn-primary" style="width: 100%;" onclick="alert('Applications open for <%= course.nextBatch %> cohort.')">
          Apply for this cohort
        </button>
      </div>
    </aside>
  </div>
</div>

<%- include('../partials/footer') %>
