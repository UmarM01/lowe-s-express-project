<%- include('../partials/head', { title }) %>
<%- include('../partials/header', { activePage }) %>

<!-- Hero Section -->
<section class="hero">
  <div class="container">
    <div class="hero-pill">
      <span style="color: var(--primary); font-size: 1rem;">✻</span>
      <span>Cohorts Now Enrolling for Fall/Winter 2026</span>
    </div>
    
    <h1>Engineering Education Built for Modern Production Systems</h1>
    <p>
      Intensive, mentor-led technical bootcamps designed to take you from core programming fundamentals to designing, deploying, and securing enterprise-scale architectures.
    </p>

    <div class="hero-actions">
      <a href="/courses" class="btn btn-default btn-lg">Browse Course Catalogue</a>
      <a href="/about" class="btn btn-outline btn-lg">Our Teaching Methodology</a>
    </div>
  </div>
</section>

<!-- Institute Key Metrics -->
<section class="stats-section">
  <div class="container">
    <div class="grid-4">
      <div class="stat-item">
        <span class="stat-number">94%</span>
        <span class="stat-label">Graduates Hired within 6 Months</span>
      </div>
      <div class="stat-item">
        <span class="stat-number">+$38k</span>
        <span class="stat-label">Average Alumni Salary Increase</span>
      </div>
      <div class="stat-item">
        <span class="stat-number">120+</span>
        <span class="stat-label">Enterprise Hiring Partners</span>
      </div>
      <div class="stat-item">
        <span class="stat-number">4.9 / 5.0</span>
        <span class="stat-label">Average Student Satisfaction Rating</span>
      </div>
    </div>
  </div>
</section>

<!-- Featured Courses Section -->
<section class="section">
  <div class="container">
    <div class="section-header">
      <div>
        <h2 class="section-title">Featured Training Programs</h2>
        <p class="section-subtitle">
          Our flagship, industry-vetted courses with immediate upcoming cohort start dates.
        </p>
      </div>
      <div>
        <a href="/courses" class="btn btn-outline btn-sm">
          View All Courses (<%= totalCourses %>) &rarr;
        </a>
      </div>
    </div>

    <!-- Course Cards Grid using reusable partial -->
    <div class="grid-3">
      <% if (featuredCourses && featuredCourses.length > 0) { %>
        <% featuredCourses.forEach(course => { %>
          <%- include('../partials/course-card', { course }) %>
        <% }); %>
      <% } else { %>
        <p style="color: var(--muted-foreground);">No featured courses found at this time.</p>
      <% } %>
    </div>
  </div>
</section>

<!-- Explore Disciplines Strip -->
<section class="section" style="background-color: var(--secondary); border-top: 1px solid var(--border); border-bottom: 1px solid var(--border);">
  <div class="container">
    <div style="text-align: center; margin-bottom: 2rem;">
      <h2 class="section-title">Explore by Domain</h2>
      <p class="section-subtitle">Choose from high-growth engineering and technology disciplines.</p>
    </div>

    <div class="grid-4">
      <% categories.forEach(cat => { %>
        <a href="/courses?category=<%= encodeURIComponent(cat) %>" class="card" style="padding: 1.5rem; text-decoration: none; transition: transform 0.15s ease;">
          <h3 style="font-size: 1rem; font-weight: 600; margin-bottom: 0.25rem;"><%= cat %></h3>
          <p style="font-size: 0.8125rem; color: var(--muted-foreground);">View accredited courses &rarr;</p>
        </a>
      <% }); %>
    </div>
  </div>
</section>

<!-- Why Choose Us -->
<section class="section">
  <div class="container">
    <div style="text-align: center; max-width: 600px; margin: 0 auto 3rem auto;">
      <h2 class="section-title">Why Train with Apex Institute</h2>
      <p class="section-subtitle">We prioritize hands-on problem solving over passive video tutorials.</p>
    </div>

    <div class="grid-3">
      <div class="card" style="padding: 2rem;">
        <div style="font-size: 1.75rem; margin-bottom: 1rem;">💻</div>
        <h3 style="font-size: 1.125rem; font-weight: 600; margin-bottom: 0.5rem;">Production-Grade Labs</h3>
        <p style="font-size: 0.875rem; color: var(--muted-foreground); line-height: 1.6;">
          Work on real codebases with Docker, PostgreSQL, cloud environments, and automated CI/CD pipelines instead of toy sandbox problems.
        </p>
      </div>

      <div class="card" style="padding: 2rem;">
        <div style="font-size: 1.75rem; margin-bottom: 1rem;">👥</div>
        <h3 style="font-size: 1.125rem; font-weight: 600; margin-bottom: 0.5rem;">Senior Staff Instructors</h3>
        <p style="font-size: 0.875rem; color: var(--muted-foreground); line-height: 1.6;">
          Learn directly from practicing Principal Engineers and Tech Leads who bring battle-tested architectural wisdom to every session.
        </p>
      </div>

      <div class="card" style="padding: 2rem;">
        <div style="font-size: 1.75rem; margin-bottom: 1rem;">🎯</div>
        <h3 style="font-size: 1.125rem; font-weight: 600; margin-bottom: 0.5rem;">Career Acceleration</h3>
        <p style="font-size: 0.875rem; color: var(--muted-foreground); line-height: 1.6;">
          Resume reviews, technical mock interviews, and direct portfolio introductions to hiring engineering managers at top companies.
        </p>
      </div>
    </div>
  </div>
</section>

<%- include('../partials/footer') %>

