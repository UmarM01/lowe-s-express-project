<%- include('../partials/head', { title }) %>
<%- include('../partials/header', { activePage }) %>

<div class="container" style="padding-top: 3rem; padding-bottom: 4rem;">
  <div style="margin-bottom: 2rem;">
    <h1 class="section-title" style="font-size: 2.25rem;">Courses</h1>
    <p class="section-desc" style="margin-bottom: 0;">
      Browse our engineering courses. Filter by discipline, experience level, or search by topic.
    </p>
  </div>

  <!-- Simplified Filter Bar -->
  <div class="filter-bar">
    <form action="/courses" method="GET" class="filter-form-simple">
      <input
        type="text"
        name="search"
        placeholder="Search by keyword, tool, or topic..."
        value="<%= currentQuery.search %>"
      >

      <select name="category">
        <option value="all" <%= currentQuery.category === 'all' ? 'selected' : '' %>>All Topics</option>
        <% categories.forEach(cat => { %>
          <option value="<%= cat %>" <%= currentQuery.category.toLowerCase() === cat.toLowerCase() ? 'selected' : '' %>>
            <%= cat %>
          </option>
        <% }); %>
      </select>

      <select name="level">
        <option value="all" <%= currentQuery.level === 'all' ? 'selected' : '' %>>All Levels</option>
        <% levels.forEach(lvl => { %>
          <option value="<%= lvl %>" <%= currentQuery.level.toLowerCase() === lvl.toLowerCase() ? 'selected' : '' %>>
            <%= lvl %>
          </option>
        <% }); %>
      </select>

      <button type="submit" class="btn btn-primary btn-sm">Filter</button>

      <% if (currentQuery.search || (currentQuery.category && currentQuery.category !== 'all') || (currentQuery.level && currentQuery.level !== 'all')) { %>
        <a href="/courses" class="filter-reset-link">Reset</a>
      <% } %>
    </form>
  </div>

  <!-- Results Count -->
  <div class="results-info">
    Showing <%= totalMatches %> <%= totalMatches === 1 ? 'course' : 'courses' %>
    <% if (currentQuery.category && currentQuery.category !== 'all') { %>
      in <em><%= currentQuery.category %></em>
    <% } %>
    <% if (currentQuery.level && currentQuery.level !== 'all') { %>
      (<%= currentQuery.level %>)
    <% } %>
    <% if (currentQuery.search) { %>
      matching "<%= currentQuery.search %>"
    <% } %>
  </div>

  <!-- Courses Grid -->
  <% if (courses && courses.length > 0) { %>
    <div class="courses-grid">
      <% courses.forEach(course => { %>
        <%- include('../partials/course-card', { course }) %>
      <% }); %>
    </div>
  <% } else { %>
    <div class="empty-box">
      <h3>No courses found</h3>
      <p>No programs matched your current search filters.</p>
      <a href="/courses" class="btn btn-secondary btn-sm">Clear filters</a>
    </div>
  <% } %>
</div>

<%- include('../partials/footer') %>
