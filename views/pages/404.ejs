<%- include('../partials/head', { title }) %>
<%- include('../partials/header', { activePage }) %>

<div class="container container-narrow" style="padding: 5rem 1.5rem; text-align: center;">
  <div style="font-family: var(--font-serif); font-size: 3rem; color: var(--accent); margin-bottom: 0.5rem; font-weight: 700;">
    404
  </div>
  <h1 class="section-title" style="margin-bottom: 0.75rem;">Page not found</h1>
  <p class="section-desc" style="margin-bottom: 2rem;">
    <%= typeof message !== 'undefined' ? message : "The page or course you are looking for does not exist." %>
  </p>

  <div style="display: flex; gap: 0.75rem; justify-content: center;">
    <a href="/" class="btn btn-primary">Return to home</a>
    <a href="/courses" class="btn btn-secondary">Browse courses</a>
  </div>
</div>

<%- include('../partials/footer') %>
