<article class="card">
  <div class="card-header">
    <div style="display: flex; align-items: center; justify-content: space-between; gap: 0.5rem; flex-wrap: wrap;">
      <div style="display: flex; gap: 0.375rem; align-items: center; flex-wrap: wrap;">
        <span class="badge badge-secondary"><%= course.category %></span>
        <span class="badge badge-outline"><%= course.level %></span>
      </div>
      <% if (course.badge) { %>
        <span class="badge badge-accent"><%= course.badge %></span>
      <% } %>
    </div>
    
    <h3 class="card-title" style="margin-top: 0.5rem;">
      <a href="/courses/<%= course.id %>" style="color: inherit; text-decoration: none;">
        <%= course.title %>
      </a>
    </h3>

    <div style="font-size: 0.8125rem; color: var(--muted-foreground);">
      Instructor: <strong style="color: var(--foreground); font-weight: 500;"><%= course.instructor.name %></strong>
    </div>
  </div>

  <div class="card-content">
    <p class="card-description">
      <%= course.summary %>
    </p>

    <div class="course-meta">
      <span title="Course Duration">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="10"></circle>
          <polyline points="12 6 12 12 16 14"></polyline>
        </svg>
        <%= course.duration %>
      </span>

      <span>•</span>

      <span title="Format">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <rect width="20" height="14" x="2" y="3" rx="2"></rect>
          <line x1="8" x2="16" y1="21" y2="21"></line>
          <line x1="12" x2="12" y1="17" y2="21"></line>
        </svg>
        <%= course.format.split(' ')[0] %>
      </span>

      <span>•</span>

      <span title="Student Rating" style="color: var(--primary); font-weight: 600;">
        ★ <%= course.rating %>
        <span style="color: var(--muted-foreground); font-weight: 400;">(<%= course.reviewCount %>)</span>
      </span>
    </div>

    <% if (course.nextBatch) { %>
      <div style="margin-top: 0.75rem; font-size: 0.75rem; color: var(--muted-foreground); display: flex; align-items: center; justify-content: space-between;">
        <span>Next Batch: <strong><%= course.nextBatch %></strong></span>
        <% if (course.seatsAvailable <= 5) { %>
          <span style="color: var(--primary); font-weight: 600;">Only <%= course.seatsAvailable %> seats left</span>
        <% } %>
      </div>
    <% } %>
  </div>

  <div class="card-footer">
    <div>
      <span class="course-price">$<%= course.price %></span>
      <span class="course-price-period"> / tuition</span>
    </div>
    <a href="/courses/<%= course.id %>" class="btn btn-outline btn-sm">
      View Details &rarr;
    </a>
  </div>
</article>
